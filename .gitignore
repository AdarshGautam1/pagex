# ==============================================================
# PAGEX Monorepo — Git Ignore Rules
# ==============================================================

# --- Critical: Environment Variables & Secrets ---
.env
.env.*
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!.env.example
!**/.env.example

# --- Credentials, Keys & Certificates ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.p8
*.keystore
*.jks
*.mobileprovision
id_rsa*
id_ed25519*
google-services.json
GoogleService-Info.plist

# --- Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp/
.pnp.js

# --- Build Outputs & Bundles ---
dist/
build/
web-build/
out/
.expo/
.expo-shared/
expo-env.d.ts

# --- Generated Native Folders (Expo Prebuild) ---
ios/
android/

# --- Logs & Runtime Output ---
logs/
*.log
.metro-health-check*

# --- Testing & Coverage ---
coverage/
.nyc_output/

# --- Cache & Temp Files ---
.cache/
.eslintcache
*.tsbuildinfo
*.tmp
*.temp
*.swp
*.swo

# --- Database & Local Dumps ---
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- IDE & Editor Configuration ---
.idea/
*.sublime-*
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
